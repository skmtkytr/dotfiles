#!/usr/bin/env bash
set -euo pipefail

info() { printf '\033[1;34m[INFO]\033[0m  %s\n' "$1"; }
ok()   { printf '\033[1;32m[OK]\033[0m    %s\n' "$1"; }

has() { command -v "$1" >/dev/null 2>&1; }

{{- if .features.in_devcontainer }}
# devcontainer に block device の自動マウントは無い。skip。
exit 0
{{- end }}

{{- if eq .chezmoi.os "linux" }}

# KDE Plasma が無い環境ではスキップ
if ! has plasmashell; then
    ok "plasmashell not found, skipping RYUJIN udev rule"
    exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

cat >"$tmp/99-no-automount-ryujin.rules" <<'RULES'
# Ignore ASUS ROG RYUJIN AIO cooler internal vfat storage.
# Avoids udisksd transient shutdown:block inhibitor race at boot that hides
# kickoff power buttons. UUID is the vfat label of the cooler partition.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="6E34-277E", ENV{UDISKS_IGNORE}="1"
RULES

udevadm verify "$tmp/99-no-automount-ryujin.rules"

info "installing RYUJIN udev rule (sudo required)"
sudo install -Dm644 "$tmp/99-no-automount-ryujin.rules" /etc/udev/rules.d/99-no-automount-ryujin.rules
sudo udevadm control --reload-rules
ok "RYUJIN udev rule installed"

{{- end }}
