#!/usr/bin/env bash
set -euo pipefail

info() { printf '\033[1;34m[INFO]\033[0m  %s\n' "$1"; }
ok()   { printf '\033[1;32m[OK]\033[0m    %s\n' "$1"; }
warn() { printf '\033[1;33m[WARN]\033[0m  %s\n' "$1"; }

has() { command -v "$1" >/dev/null 2>&1; }

{{- if .features.in_devcontainer }}
# devcontainer は USB デバイスも kernel module も扱わない。skip。
exit 0
{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{- $id := .chezmoi.osRelease.id }}
{{- if or (eq $id "arch") (eq $id "manjaro") (eq $id "cachyos") (eq $id "endeavouros") }}

# KDE Plasma が無い環境ではスキップ
if ! has plasmashell; then
    ok "plasmashell not found, skipping INZONE Buds battery setup"
    exit 0
fi

# INZONE Buds の左右/ケース電池を UPower → KDE に出す
# 実機で確認した commit に固定 (root で kernel に入るので追従しない)
repo="https://github.com/patyhank/linzone-hub.git"
commit="d12fe2376193aecf9caec1a438369c75b1aa173a"
module="hid-inzone-battery"
version="0.1.12"
kernel="$(uname -r)"

if [ ! -d "/usr/lib/modules/$kernel/build" ]; then
    warn "kernel headers not found for $kernel — install them and re-run"
    exit 1
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# SOUND_FORM_FACTOR が無いと UPower の種別が other_audio で止まり、
# Solid が電池として扱わず KDE に表示されない
cat >"$tmp/79-inzone-buds-sound.rules" <<'RULES'
SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ec2", ENV{SOUND_FORM_FACTOR}="headset"
RULES

info "fetching linzone-hub ${commit:0:7}"
git -C "$tmp" init -q src
git -C "$tmp/src" fetch -q --depth 1 "$repo" "$commit"
git -C "$tmp/src" checkout -q FETCH_HEAD
src="$tmp/src/kernel/hid-inzone-battery-dkms"

# 壊れたルールは全デバイスに波及し得るので、配置前に検証する
udevadm verify "$tmp/79-inzone-buds-sound.rules"

info "installing INZONE Buds battery driver (sudo required)"
sudo pacman -S --needed --noconfirm dkms

if [ -z "$(dkms status -m "$module" -v "$version")" ]; then
    sudo dkms add "$src"
fi
if ! dkms status -m "$module" -v "$version" -k "$kernel" | grep -q 'installed'; then
    sudo dkms install -m "$module" -v "$version"
fi

sudo install -Dm644 "$tmp/79-inzone-buds-sound.rules" /etc/udev/rules.d/79-inzone-buds-sound.rules
sudo install -Dm644 "$src/99-inzone-battery.rules" /etc/udev/rules.d/99-inzone-battery.rules
echo hid_inzone_battery | sudo tee /etc/modules-load.d/inzone-battery.conf >/dev/null

sudo udevadm control --reload-rules
sudo udevadm trigger
sudo modprobe hid_inzone_battery

ok "INZONE Buds battery driver installed"
warn "接続中のドングルは抜き挿しすること"

{{- end }}
{{- end }}
