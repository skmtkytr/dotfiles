#!/usr/bin/env bash
set -euo pipefail

info() { printf '\033[1;34m[INFO]\033[0m  %s\n' "$1"; }
ok()   { printf '\033[1;32m[OK]\033[0m    %s\n' "$1"; }
warn() { printf '\033[1;33m[WARN]\033[0m  %s\n' "$1"; }

has() { command -v "$1" >/dev/null 2>&1; }

{{- if .features.in_devcontainer }}
# devcontainer は GUI IME を持たない。skip。
exit 0
{{- end }}

{{- if eq .chezmoi.os "linux" }}

# hazkey (fcitx5) が無い環境ではスキップ
if [ ! -f /usr/lib/fcitx5/fcitx5-hazkey.so ]; then
    warn "hazkey not installed (fcitx5-hazkey-bin) — skip zenzai model fetch"
    exit 0
fi

# zenz-v3.1-small (Q5_K_M) — hazkey の Zenzai ニューラル変換モデル
# AUR hazkey-zenzai-model と同一ファイル/ハッシュ
url="https://huggingface.co/Miwa-Keita/zenz-v3.1-small-gguf/resolve/main/ggml-model-Q5_K_M.gguf"
sha="4de930c06bef8c263aa1aa40684af206db4ce1b96375b3b8ed0ea508e0b14f6c"
dir="${XDG_DATA_HOME:-$HOME/.local/share}/hazkey/zenzai"
dest="$dir/zenzai.gguf"

if [ -f "$dest" ] && echo "$sha  $dest" | sha256sum -c - >/dev/null 2>&1; then
    ok "zenzai model already present"
    exit 0
fi

info "downloading zenzai model (~70MB)"
mkdir -p "$dir"
curl -fL --retry 3 "$url" -o "$dest.tmp"
if ! echo "$sha  $dest.tmp" | sha256sum -c - >/dev/null 2>&1; then
    rm -f "$dest.tmp"
    warn "zenzai model checksum mismatch — aborted"
    exit 1
fi
mv "$dest.tmp" "$dest"
ok "zenzai model installed: $dest"
warn "hazkey-settings で Zenzai を有効化 (CPU backend) すること"

{{- end }}
